<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <Version>1.1.6</Version>
    <Product>GameLibrary</Product>
    <AssemblyTitle>GameLibrary Desktop</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms 仅用于托盘 NotifyIcon；隐式 using 会引入 System.Windows.Forms/System.Drawing
         与 WPF 类型名冲突（Application/Image/KeyEventArgs），故显式移除，代码内用 WinForms: 别名。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- UIA 冒烟测试抓到的启动崩溃修复：Icon="App.ico" 走 pack URI，必须以 Resource 嵌入程序集
         （ApplicationIcon 只设置 EXE 文件图标，不进 WPF 资源清单）。 -->
    <Resource Include="App.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameLibrary.HostClient\GameLibrary.HostClient.csproj" />
    <ProjectReference Include="..\GameLibrary.Contracts\GameLibrary.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameLibrary.IntegrationTests" />
  </ItemGroup>

  <!-- 开发布局兜底：HostProcessLauncher 按"与 Desktop.exe 同目录"解析 Host；
       EXE 不会被项目引用自动复制，故构建后把 Host 运行时整目录复制到输出
       （仅文件复制，不建立项目引用——依赖方向仍为 Desktop → HostClient → IPC）。
       仅在非 RID（framework-dependent）构建时执行：RID/publish 输出自带自包含
       Host，复制 framework-dependent 版本进去会造出"无法启动"的宿主副本
       （用户实测退出码 0x80008096 = 缺 .NET 运行时）。 -->
  <Target Name="CopyHostRuntime" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <HostRuntimeFiles
          Include="..\GameLibrary.Host\bin\$(Configuration)\$(TargetFramework)\**\*.*"
          Exclude="..\GameLibrary.Host\bin\$(Configuration)\$(TargetFramework)\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(HostRuntimeFiles)"
          DestinationFiles="@(HostRuntimeFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
