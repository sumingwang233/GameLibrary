<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms 仅用于托盘 NotifyIcon；隐式 using 会引入 System.Windows.Forms/System.Drawing
         与 WPF 类型名冲突（Application/Image/KeyEventArgs），故显式移除，代码内用 WinForms: 别名。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameLibrary.HostClient\GameLibrary.HostClient.csproj" />
    <ProjectReference Include="..\GameLibrary.Contracts\GameLibrary.Contracts.csproj" />
  </ItemGroup>

</Project>
