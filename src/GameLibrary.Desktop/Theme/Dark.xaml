<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Steam 库风格深色色板（默认主题）。
         审查修复：Danger 由 #c15959 提亮为 #e06c6c（深色底对比度 ≥ 4.5:1）。 -->
    <SolidColorBrush x:Key="BgTop" Color="#171a21" />
    <SolidColorBrush x:Key="BgMain" Color="#1b2838" />
    <SolidColorBrush x:Key="BgPanel" Color="#16202d" />
    <SolidColorBrush x:Key="BgRow" Color="#16202d" />
    <SolidColorBrush x:Key="BgRowHover" Color="#2a475e" />
    <SolidColorBrush x:Key="BgRowSelected" Color="#316282" />
    <SolidColorBrush x:Key="Sep" Color="#2a475e" />
    <SolidColorBrush x:Key="Accent" Color="#66c0f4" />
    <SolidColorBrush x:Key="AccentDim" Color="#417a9b" />
    <SolidColorBrush x:Key="TextPrimary" Color="#ffffff" />
    <SolidColorBrush x:Key="TextBody" Color="#c7d5e0" />
    <SolidColorBrush x:Key="TextMuted" Color="#9aa7b0" />
    <SolidColorBrush x:Key="Green" Color="#a1cd44" />
    <SolidColorBrush x:Key="GreenHover" Color="#b6dd5c" />
    <SolidColorBrush x:Key="Danger" Color="#e06c6c" />
</ResourceDictionary>
