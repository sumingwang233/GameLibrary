<Window x:Class="GameLibrary.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameLibrary"
        Width="1040"
        Height="680"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：连接与库状态 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button Name="ConnectButton" Content="连接宿主" Click="OnConnectClick" DockPanel.Dock="Right" Padding="10,4" />
            <TextBlock Name="StatusText" Text="未连接" VerticalAlignment="Center" FontWeight="Bold" />
        </DockPanel>

        <!-- 扫描与库操作 -->
        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <Button Name="InitLibraryButton" Content="初始化库" Click="OnInitLibraryClick" DockPanel.Dock="Right" Padding="10,4" Margin="4,0,0,0" />
            <Button Name="AddRootButton" Content="注册库根" Click="OnAddRootClick" DockPanel.Dock="Right" Padding="10,4" Margin="4,0,0,0" />
            <Button Name="ScanButton" Content="扫描" Click="OnScanClick" DockPanel.Dock="Right" Padding="10,4" Margin="4,0,0,0" />
            <TextBox Name="RootBox" VerticalContentAlignment="Center" />
        </DockPanel>

        <!-- 主体：卡片 / 候选 -->
        <TabControl Grid.Row="2">
            <TabItem Header="游戏卡片">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel Name="GamesPanel" Margin="4" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="候选审核">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="CandidatesPanel" Margin="4" />
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,4,0,0" Text="" />
    </Grid>
</Window>
