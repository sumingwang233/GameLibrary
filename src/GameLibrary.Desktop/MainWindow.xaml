<Window x:Class="GameLibrary.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameLibrary"
        Width="1180"
        Height="720"
        MinWidth="960"
        MinHeight="600"
        Background="{StaticResource BgMain}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Sep" Color="#2a475e" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- 顶栏：Logo + 工具栏（Steam 全局导航风格） -->
        <Border Grid.Row="0" Background="{StaticResource BgTop}" Padding="12,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Text="GAMELIBRARY"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center" Margin="0,0,18,0" />
                <Button Name="RefreshButton" Content="刷新" Style="{StaticResource SteamButton}"
                        Click="OnRefreshClick" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" />
                <Button Name="ConnectButton" Content="连接宿主" Style="{StaticResource SteamButton}"
                        Click="OnConnectClick" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Name="InitLibraryButton" Content="初始化库" Style="{StaticResource SteamButton}"
                            Click="OnInitLibraryClick" Margin="4,0,0,0" />
                    <Button Name="AddRootButton" Content="注册库根" Style="{StaticResource SteamButton}"
                            Click="OnAddRootClick" Margin="4,0,0,0" />
                    <Button Name="ScanButton" Content="扫描" Style="{StaticResource SteamBlueButton}"
                            Click="OnScanClick" Margin="4,0,0,0" />
                </StackPanel>
                <TextBox Name="RootBox" VerticalAlignment="Center" MinWidth="320" Margin="0,0,12,0"
                         ToolTip="数据目录 / 待扫描库根路径" />
            </DockPanel>
        </Border>

        <!-- 主区：左侧列表 + 右侧详情 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：视图切换 + 搜索 + 游戏列表（Steam 侧边栏，虚拟化） -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Sep}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <ComboBox Name="ViewSelector" DockPanel.Dock="Top" Margin="8,10,8,4"
                              Background="{StaticResource BgPanel}" Foreground="{StaticResource TextBody}"
                              SelectionChanged="OnViewSelectorChanged" />
                    <TextBox Name="SearchBox" DockPanel.Dock="Top" Margin="8,0,8,6"
                             ToolTip="搜索游戏标题（Ctrl+F 聚焦，300ms 防抖）" />
                    <TextBlock DockPanel.Dock="Top" Text="库" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}" Margin="12,4,0,6" />
                    <ListBox Name="LibraryList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             SelectionMode="Single"
                             SelectionChanged="OnLibrarySelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True" />
                </DockPanel>
            </Border>

            <!-- 右：详情面板 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Name="DetailPanel" Margin="24,18" />
            </ScrollViewer>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource BgTop}" Padding="12,0">
            <DockPanel>
                <TextBlock Name="ErrorText" DockPanel.Dock="Right" Foreground="{StaticResource Danger}"
                           FontSize="11" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock Name="StatusText" Text="未连接" Foreground="{StaticResource TextMuted}"
                           FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
