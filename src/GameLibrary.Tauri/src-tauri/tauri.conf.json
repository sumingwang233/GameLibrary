{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameLibrary",
  "identifier": "com.gamelibrary.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:sidecars && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run clean:tauri-cache && npm run prepare:sidecars && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GameLibrary",
        "width": 1320,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/GameLibrary.TauriBridge", "binaries/GameLibrary.Host"],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
